# Copy to .env and fill in. .env is gitignored and never goes into the image.
# On Vercel, set these as project environment variables instead.

# --- LLM: Claude does entity/fact extraction ---------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Fallback LLM, used only when ANTHROPIC_API_KEY is unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Graph backend: neo4j | falkordb -----------------------------------------
GRAPH_BACKEND=neo4j

# Neo4j Aura: values from the credentials .txt Aura offers when the instance
# is created. Every group lives in this one database (group_id is a property).
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<instance-id>
NEO4J_PASSWORD=
NEO4J_DATABASE=<instance-id>

# Local Neo4j instead:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# FalkorDB (docker compose up -d). A group_id here is a separate graph;
# FALKORDB_DATABASE names the default one.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_DATABASE=graphiti

# --- Embeddings ---------------------------------------------------------------
# Must match the local embedder in add_episodes.py (all-MiniLM-L6-v2 = 384).
EMBEDDING_DIM=384

# --- api.py -------------------------------------------------------------------
# Clients send this as the x-api-key header. The server won't start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRAPHITI_API_KEY=
